<div class="author">
    <h1 class="author-heading">Welcome to My Blog</h1>
    <p class="author-body">Web Developer Blog</p>
</div>

<section class="articles">
    <h2 class="articles__heading">Latest Articles</h2>
    <ul class="article-ul">
        <% data.forEach(posts => { %>
           <li><a href="/post/<%= posts._id %>">
            <span><%= posts.title %></span>
            <span class="article-list__date"><%= posts.createdAt.toDateString() %></span>
        </a></li>

        <% }) %>
    </ul>
    <div class="pagination">
        <a href="/?page=<%= nextPage %>" class="pagination__link">
            View Older Posts
        </a>

        <% if(previousPage > 0){ %>
            <a href="/?page=<%= previousPage %>" class="pagination__link">
                View Newer Posts
            </a>
        <% } %>

        

    </div>
    
</section>